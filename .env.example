# HanVerse runtime configuration (use DATABASE_URL or NEON_DATABASE_URL in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
# Keep this key stable. If omitted, admin MFA encryption derives from JWT_SECRET.
ADMIN_MFA_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# AI providers (at least one provider is required for AI features)
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
PANDA_CHAT_MODEL=gpt-4o-mini
AI_DISABLED=0

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canonical production frontend URL (used by Stripe success/cancel redirects)
PUBLIC_SITE_URL=https://learn-hanverse.netlify.app

# Database Configuration
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=your_database_name
DB_PASSWORD=your_db_password
DB_PORT=5432

# Email Configuration (Brevo SMTP)
BREVO_SMTP_KEY=your_brevo_smtp_key
EMAIL_FROM="Hanverse" <your-verified-sender@yourdomain.com>

# Frontend URL Configuration
# For localhost development
FRONTEND_URL=http://localhost:3000
# For production, use your production URL
# FRONTEND_URL=https://yourproductionurl.com

# Server Configuration
PORT=3000
HOST=0.0.0.0  # Use 0.0.0.0 to allow external connections, or localhost for local-only
NODE_ENV=development  # Change to 'production' for production deployments