# Local and Netlify environment variables
# Copy this to .env for local development and set DATABASE_URL in Netlify Site Settings.

DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-little-brook-airyxne9-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
BREVO_SMTP_KEY=your_brevo_smtp_key   # required for verification + password reset emails
EMAIL_FROM="Hanverse" <your-verified-sender@yourdomain.com>   # verified sender in Brevo
FRONTEND_URL=http://localhost:3000   # optional; if unset, links are built from the request Origin
PORT=3000
NODE_ENV=development
